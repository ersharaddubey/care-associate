{
  "expo": {
    "name": "Care Associate",
    "slug": "care-associate",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1769AA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.careassociate.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Care Associate to access selected photos so you can upload private documents and your masked Aadhaar card."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow Care Associate to share live location with the patient only during active duty.",
          "locationAlwaysPermission": "Allow Care Associate to share live location with the patient only during active duty.",
          "locationWhenInUsePermission": "Allow Care Associate to share live location with the patient during active duty."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "booking-updates",
          "color": "#1769AA",
          "enableRemoteNotifications": true
        }
      ]
    ]
  }
}
