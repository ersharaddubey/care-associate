# Use MongoDB Atlas for deployed environments. For local development, use a local MongoDB URI.
# Example Atlas format (keep real credentials only in server/.env or Vercel environment variables):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/care-associate?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=5001
ADMIN_PHONE=replace-with-your-admin-mobile-number
ADMIN_PASSWORD=replace-with-your-6-digit-admin-password

# Gmail SMTP for passwordless Patient/Care Associate email OTP (use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=Care Associate <your-gmail-address@gmail.com>

# Cashfree PG (start with SANDBOX; never commit real credentials)
CASHFREE_CLIENT_ID=your-cashfree-app-id
CASHFREE_CLIENT_SECRET=your-cashfree-secret-key
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# Business owner must choose commission; basis points (100 = 1%). Leave unset until decided.
# PLATFORM_COMMISSION_BPS=

# Cloudinary (required for private Aadhaar and document vault uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
